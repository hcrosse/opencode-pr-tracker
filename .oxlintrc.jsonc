{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "suspicious": "error",
  },
  "env": {
    "builtin": true,
  },
  // The issue-claim workflow script and its test predate this profile and are kept unchanged.
  "ignorePatterns": [
    "tools/oxlint/anti-slop/**",
    ".github/scripts/**",
    "test/repository/issue-claim.test.ts",
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts",
    },
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true,
    "typeCheck": true,
  },
  "plugins": ["eslint", "oxc", "typescript", "unicorn"],
  "rules": {
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "eslint/complexity": ["error", { "max": 8, "variant": "classic" }],
    "eslint/max-depth": ["error", { "max": 3 }],
    "eslint/max-lines": ["error", { "max": 250, "skipBlankLines": false, "skipComments": false }],
    // Effect pairs a schema value with a type of the same name; TypeScript reports real redeclarations.
    "eslint/no-redeclare": "off",
    // Effect tagged unions discriminate on `_tag`; GitHub GraphQL responses on `__typename`.
    "eslint/no-underscore-dangle": ["error", { "allow": ["_tag", "__typename"] }],
    "eslint/max-lines-per-function": [
      "error",
      {
        "IIFEs": true,
        "max": 40,
        "skipBlankLines": false,
        "skipComments": false,
      },
    ],
    "eslint/max-params": ["error", { "countThis": "except-void", "max": 3 }],
    "oxc/no-accumulating-spread": "error",
    // Effect values and requests are immutable data that expose methods such as `pipe`; Ref,
    // PubSub, Semaphore, Deferred and Scope are shared handles changed only through Effect operations; Hegel's
    // TestCase is a library class. OpenTUI's RGBA is a host color class that the sidebar only passes on.
    // Solid's JSX.Element (a mutable array or DOM node, by type) is rendered, never changed. The TUI
    // plugin Context holds host objects, such as the renderer, that the plugin reads and never changes.
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": [
              "Effect",
              "Layer",
              "Option",
              "Some",
              "None",
              "Result",
              "Success",
              "Failure",
              "Duration",
              "Stream",
              "Ref",
              "PubSub",
              "Semaphore",
              "Deferred",
              "Scope",
              "HttpClientRequest",
            ],
            "package": "effect",
          },
          { "from": "package", "name": "TestCase", "package": "@hegeldev/hegel" },
          { "from": "package", "name": "RGBA", "package": "@opentui/core" },
          { "from": "package", "name": "Element", "package": "solid-js" },
          { "from": "package", "name": "Context", "package": "@opencode/plugin" },
          // Tagged errors declare readonly fields; only members inherited from Error are mutable.
          {
            "from": "file",
            "name": ["InvalidPullRequestInput", "InvalidPullRequestUrl"],
            "path": "src/domain/PullRequest.ts",
          },
          {
            "from": "file",
            "name": ["AmbiguousPullRequestNumber", "AttachmentLimitReached"],
            "path": "src/domain/Tracking.ts",
          },
          {
            "from": "file",
            "name": ["GitHubFailure", "RepositoryUnavailable"],
            "path": "src/ports/GitHub.ts",
          },
          {
            "from": "file",
            "name": "StoredStateInvalid",
            "path": "src/ports/TrackingRepository.ts",
          },
          {
            "from": "file",
            "name": ["PullRequestUnavailable", "StackIncomplete"],
            "path": "src/application/Tracker.ts",
          },
        ],
        "treatMethodsAsReadonly": true,
      },
    ],
    // Promise-returning functions use async/await in Bun projects.
    "oxc/no-async-await": "off",
  },
  "overrides": [
    {
      // These command-line scripts report through the console.
      "files": ["scripts/build.ts", "scripts/check-pr-title.ts"],
      "rules": { "eslint/no-console": "off" },
    },
    {
      // A module declares its Schema or service class together with the tagged errors it returns.
      "files": ["src/**"],
      "rules": { "eslint/max-classes-per-file": "off" },
    },
  ],
}
