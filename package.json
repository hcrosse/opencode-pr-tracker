{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@hcrosse/opencode-pr-tracker",
  "version": "0.2.0",
  "description": "Track GitHub pull requests in the OpenCode sidebar.",
  "homepage": "https://github.com/hcrosse/opencode-pr-tracker#readme",
  "bugs": {
    "url": "https://github.com/hcrosse/opencode-pr-tracker/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcrosse/opencode-pr-tracker.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "bun ./scripts/build.ts",
    "smoke:opencode": "bun ./scripts/smoke-opencode.ts",
    "prepack": "bun run build",
    "package:check": "bun run build && npm pack --dry-run --ignore-scripts",
    "check": "bun run lint && bun run format:check && bun test && bun run package:check && git diff --check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.2",
    "@types/proper-lockfile": "4.1.4",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "solid-js": "1.9.12",
    "web-tree-sitter": "0.25.10"
  },
  "peerDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "engines": {
    "node": ">=22.12.0",
    "opencode": ">=1.18.15 <2"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": []
}
