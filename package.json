{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@hcrosse/opencode-pr-tracker",
  "version": "0.4.4",
  "description": "Track GitHub pull requests in the OpenCode sidebar.",
  "homepage": "https://github.com/hcrosse/opencode-pr-tracker#readme",
  "bugs": {
    "url": "https://github.com/hcrosse/opencode-pr-tracker/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcrosse/opencode-pr-tracker.git"
  },
  "files": [
    "dist",
    "server.js",
    "tui.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit": "bun audit",
    "build": "bun ./scripts/build.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test && bun run package:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "package:check": "bun run build && npm pack --dry-run --ignore-scripts",
    "prepack": "bun run build",
    "smoke:opencode": "bun run build && bun ./scripts/smoke-opencode.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.15",
    "@opencode/schema": "2.0.15",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@hegeldev/hegel": "0.4.3",
    "@opencode/cli": "2.0.15",
    "@opencode/client": "2.0.15",
    "@opencode/theme": "2.0.15",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112"
  },
  "engines": {
    "opencode": ">=2.0.15 <3"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": []
}
